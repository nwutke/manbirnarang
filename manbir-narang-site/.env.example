# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Your live site address (used for the sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Enquiry notification (server only; never prefix these with NEXT_PUBLIC_).
# Comma-separated. Use this address while testing, then switch it to Manbir.
LEAD_NOTIFY_EMAIL=nicholaswutke@gmail.com
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Until a sending domain is verified in Resend, leave this as the shared test sender.
# That address can only deliver to the email on the Resend account.
LEAD_FROM_EMAIL=onboarding@resend.dev
